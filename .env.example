# Discord Bot Token (required)
DISCORD_TOKEN=your_discord_bot_token

# Fish Audio API Key (required for Phase 1)
FISH_API_KEY=your_fish_audio_api_key

# Fish Audio Model ID for Hatsune Miku voice
FISH_MODEL_ID=

# Maximum characters per TTS message (default: 150)
MAX_MESSAGE_LENGTH=150

# Cache directory for generated audio
CACHE_DIR=cache

# Optional directory containing Hatsune Miku images
MIKU_IMAGE_DIR=

# Optional API URLs (comma-separated) for random Hatsune Miku images
MIKU_IMAGE_API_URLS=https://miku-for.us/api/v2/random,https://danbooru.donmai.us/posts/random.json?tags=hatsune_miku+rating:s

# Optional single API URL for random Hatsune Miku images (fallback if URLS not set)
MIKU_IMAGE_API_URL=

# Optional path to a TTF font for image captions
MIKU_FONT_PATH=
